[Unit]
Description=keep-ram-clean (User Mode) — tmpfs, Watchdog & Cache Cleanup Daemon
After=default.target

[Service]
Type=simple
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/keep-ram-clean daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
UMask=0077

# User-mode hardening
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
